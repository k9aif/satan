# K9X Satan — environment. Copy to .env (never commit .env):
#   cp .env.sample .env
# ubuntu/build-run.sh passes .env into the container (--env-file).

# Ollama the target agents call. Inside the container, localhost is the container
# itself: use the host alias, or the Ollama host's LAN address.
OLLAMA_BASE_URL=http://host.containers.internal:11434

# Model for the agents' "general" calls; unset = config.yaml default (llama3.2:1b).
# SATAN_LLM_MODEL=llama3.2:1b

# Optional: Docling extraction (off unless SATAN_DOCLING=true)
# SATAN_DOCLING=false
# DOCLING_URL=http://host.containers.internal
# DOCLING_PORT=5001
# DOCLING_TIMEOUT=300
