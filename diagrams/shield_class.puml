@startuml shield_class

skinparam defaultFontName Courier
skinparam defaultFontSize 11
skinparam linetype ortho

' ── K9-AIF ABBs (framework — abstract contracts) ────────────────────────────

package "K9-AIF Framework ABBs" {

  abstract class BaseVulnerabilityCheck {
    {abstract} +check(payload: dict): CheckResult
    #name: str
    #description: str
  }

  class VulnerabilityChain {
    -_checks: List[BaseVulnerabilityCheck]
    +add(check: BaseVulnerabilityCheck): self
    +run(payload: dict): CheckResult
  }

  abstract class BaseRouter {
    {abstract} #_build_ingress_chain(): VulnerabilityChain
    +route(payload: dict): dict
    -_run_ingress_checks(payload): CheckResult
  }

  abstract class BaseOrchestrator {
    {abstract} #_build_egress_chain(): VulnerabilityChain
    +execute_flow(payload: dict): dict
    -_run_egress_checks(payload): CheckResult
  }

  abstract class BaseAgent {
    {abstract} +execute(payload: dict): dict
    +enforce_governance()
    +publish_event(event: dict)
    #governance: BaseGovernance
  }

  abstract class BaseGovernance {
    {abstract} +pre_process(payload: dict, ctx): dict
    {abstract} +post_process(payload: dict, ctx): dict
  }

}

' ── K9-AIF Framework OOB Checks (concrete, framework-provided) ──────────────
' These live in k9_aif_abb/k9_security/vulnerability/checks/ — NOT Satan code.
' Satan wires them into its own VulnerabilityChain instances (below).

package "K9-AIF Framework OOB Checks" {

  class InputSizeCheck {
    +check(payload): CheckResult
    ' Ingress · catches: token-flood / oversized payload
  }

  class PromptInjectionCheck {
    +check(payload): CheckResult
    ' Ingress · catches: SYSTEM OVERRIDE, ignore all instructions
  }

  class SemanticDriftCheck {
    +check(payload): CheckResult
    ' Egress · catches: goal hijacking, identity override, loop traps
  }

  class PIIBoundaryCheck {
    +check(payload): CheckResult
    ' Egress · catches: SSN / credit card / email crossing the boundary
  }

  class ToolArgumentCheck {
    +check(payload): CheckResult
    ' Egress · catches: SQLi / command injection / path traversal / SSRF
  }

  class ExecutionGuardCheck {
    +check(payload): CheckResult
    ' Egress · catches: destructive commands, reverse shells, persistence
  }

  class HardcodedCredentialCheck {
    +check(payload): CheckResult
    ' Egress · catches: API keys / secrets echoed into the response
  }

}

' ── K9X Satan SBBs (this repo — extends the ABBs above) ─────────────────────

package "K9X Satan — Shield SBBs" {

  class FieldAnomalyCheck {
    -_RED_FLAG_KEYS: Set[str]
    -_RED_FLAG_VALUE_PATTERNS: List[Pattern]
    -_RED_FLAG_RAW_PATTERNS: List[Pattern]
    +check(payload): CheckResult
    ' Ingress · catches: EXEC-OVERRIDE, Priority: CRITICAL, COO auth codes
  }

  class MemoryPoisoningCheck {
    -_cache: BaseCache
    -_TRACKED_FACT_KEYS: Set[str]
    +check(payload): CheckResult
    ' Ingress · catches: fabricated/contradicted session memory (Zscaler
    ' Memory Poisoning) — uses CacheFactory to fingerprint session facts
  }

  class RequestFrequencyCheck {
    -_cache: BaseCache
    -_max_requests: int
    -_window_seconds: int
    +check(payload): CheckResult
    ' Ingress · catches: per-session resource-exhaustion request floods
  }

  class ToolAuthorizationCheck {
    -_approved_tools: Set[str]
    -_approved_backends: List[str]
    +check(payload): CheckResult
    ' Egress · catches: unapproved tool/backend (Zscaler Shadow AI)
  }

  class SystemPromptLeakageCheck {
    -_fragments: List[str]
    +check(payload): CheckResult
    ' Egress · catches: agent echoing its own system prompt verbatim
  }

  class OutputSanitizationCheck {
    -_patterns: List[Pattern]
    +check(payload): CheckResult
    ' Egress · catches: <script>/markup/template injection in output
  }

  class DoclingExtractor {
    -_enabled: bool
    -_url: str
    -_timeout: int
    +enrich(payload: dict): dict
    -_naive_extract(text): Dict[str,str]
    -_extract_via_docling(text): Tuple[Dict,bool]
    -_docling_endpoint(text): Dict[str,str]
    ' PRE-SHIELD: populates extracted_fields
  }

  class DocumentRouter {
    #_build_ingress_chain(): VulnerabilityChain
    +route(payload: dict): dict
  }

  class DocumentOrchestrator {
    #_build_egress_chain(): VulnerabilityChain
    +execute_flow(payload: dict): dict
  }

  class DocumentExtractionAgent {
    +execute(payload: dict): dict
    ' extracts text fields, confidence score
  }

  class AuditAgent {
    +execute(payload: dict): dict
    ' audit trail, compliance record
  }

  class GuardianGovernance {
    -_model: str
    -_base: str
    -_timeout: int
    +pre_process(payload, ctx): dict
    +post_process(payload, ctx): dict
    -_call_guardian(system, content): Tuple[str,str]
    ' model: granite4.1-guardian:8b
  }

  class NoopGovernance {
    +pre_process(payload, ctx): dict
    +post_process(payload, ctx): dict
    ' passthrough — development only
  }

}

' ── Inheritance ──────────────────────────────────────────────────────────────

BaseVulnerabilityCheck <|-- InputSizeCheck
BaseVulnerabilityCheck <|-- PromptInjectionCheck
BaseVulnerabilityCheck <|-- SemanticDriftCheck
BaseVulnerabilityCheck <|-- PIIBoundaryCheck
BaseVulnerabilityCheck <|-- ToolArgumentCheck
BaseVulnerabilityCheck <|-- ExecutionGuardCheck
BaseVulnerabilityCheck <|-- HardcodedCredentialCheck

BaseVulnerabilityCheck <|-- FieldAnomalyCheck
BaseVulnerabilityCheck <|-- MemoryPoisoningCheck
BaseVulnerabilityCheck <|-- RequestFrequencyCheck
BaseVulnerabilityCheck <|-- ToolAuthorizationCheck
BaseVulnerabilityCheck <|-- SystemPromptLeakageCheck
BaseVulnerabilityCheck <|-- OutputSanitizationCheck

BaseRouter       <|-- DocumentRouter
BaseOrchestrator <|-- DocumentOrchestrator
BaseAgent        <|-- DocumentExtractionAgent
BaseAgent        <|-- AuditAgent
BaseGovernance   <|-- GuardianGovernance
BaseGovernance   <|-- NoopGovernance

' ── Composition ──────────────────────────────────────────────────────────────

VulnerabilityChain "1" *--> "1..N" BaseVulnerabilityCheck : contains >
DocumentRouter    "1" *--> "1"     VulnerabilityChain      : ingress chain >
DocumentOrchestrator "1" *--> "1"  VulnerabilityChain      : egress chain >

BaseAgent "N" o--> "1" BaseGovernance : uses >

DocumentOrchestrator "1" --> "1" DocumentExtractionAgent
DocumentOrchestrator "1" --> "1" AuditAgent

note right of DoclingExtractor
  Runs before VulnerabilityChain.
  Populates extracted_fields so
  FieldAnomalyCheck + MemoryPoisoningCheck
  have structured field data at ingress.
end note

note right of GuardianGovernance
  Wraps every agent's pre/post hooks.
  Calls granite4.1-guardian:8b via
  Ollama for semantic safety check —
  catches what regex-based checks can't
  (paraphrase, encoding, indirection).
end note

note bottom of MemoryPoisoningCheck
  Ingress chain order:
  RequestFrequencyCheck -> InputSizeCheck ->
  PromptInjectionCheck -> FieldAnomalyCheck ->
  MemoryPoisoningCheck
end note

note bottom of OutputSanitizationCheck
  Egress chain order:
  SemanticDriftCheck -> ExecutionGuardCheck ->
  PIIBoundaryCheck -> ToolArgumentCheck ->
  HardcodedCredentialCheck -> ToolAuthorizationCheck ->
  SystemPromptLeakageCheck -> OutputSanitizationCheck
end note

@enduml
